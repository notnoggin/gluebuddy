{
  "name": "gluebuddy",
  "productName": "Gluebuddy",
  "version": "0.1.0",
  "description": "Stick notes, links, code, images and files to any app. Find them when you're back.",
  "main": "main.js",
  "private": true,
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win"
  },
  "dependencies": { "active-win": "^8.2.1" },
  "devDependencies": { "electron": "^31.0.0" },
  "build": {
    "appId": "com.gluebuddy.app",
    "productName": "Gluebuddy",
    "files": ["main.js", "index.html", "renderer.js", "icon.png", "tray.png", "fonts/**"],
    "asarUnpack": ["node_modules/active-win/**"],
    "win": { "target": "nsis", "icon": "icon.ico" }
  }
}
